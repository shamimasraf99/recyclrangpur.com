# ============================================================================
# BikroyBD React Frontend — Public Build-Time Environment Variables
# ============================================================================
# SECURITY NOTICE:
# Everything prefixed with VITE_ is embedded into the public client JavaScript bundle.
# NEVER place DB_PASSWORD, JWT_*_SECRET, COOKIE_SECRET, or CLOUDINARY_API_SECRET here!
# ============================================================================

# When served behind Nginx on the same domain (recommended), keep /api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_URL=https://bikroybd.com
VITE_DEFAULT_LOCALE=bn-BD
