{
  "name": "bangladesh-used-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Bangladesh Used Products Marketplace (BikroyBD) — Bilingual Bengali/English Platform",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "node scripts/build_production.js",
    "start": "npm run start --workspace=server",
    "db:migrate": "node database/migrate.js up",
    "db:migrate:verify": "node database/migrate.js verify",
    "db:seed": "node database/migrate.js seed",
    "db:audit": "node database/backup_restore.js audit",
    "db:backup": "node database/backup_restore.js backup",
    "db:restore": "node database/backup_restore.js restore",
    "test": "node tests/run_phase6_audit.js",
    "test:smoke": "node deploy/scripts/smoke_test.js",
    "test:unit": "npm run test:unit --workspace=server",
    "test:integration": "npm run test:integration --workspace=server",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
