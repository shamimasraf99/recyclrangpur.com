# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ==========================================
# Bangladesh Used Products Marketplace (BikroyBD)
# Backend & MySQL Database Environment Variables
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
TRUST_PROXY=1

# Database Configuration (MySQL 8.0+)
# In production, use restricted runtime user 'bikroybd_app' (never 'root')
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bikroybd_user
DB_PASSWORD=your_secure_db_password
DB_NAME=bikroybd_db
DB_CONNECTION_LIMIT=20

# Authentication, JWT & Cookie Hardening
JWT_ACCESS_SECRET=your_jwt_access_secret_64_characters_minimum
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_characters_minimum
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
COOKIE_SECRET=your_cookie_signing_secret
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false

# Logging & Operations
LOG_LEVEL=info
LOG_DIR=/var/log/bikroybd

# Object Storage (Cloudinary / Compatible S3)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

