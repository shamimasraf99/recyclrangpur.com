# ============================================================================
# Recycl Rangpur — Production Environment Template (/etc/bikroybd/api.env)
# ============================================================================
# CRITICAL SECURITY INSTRUCTIONS:
# 1. Copy this file to /etc/bikroybd/api.env on the target Linux VPS (OUTSIDE the Git repository).
# 2. Restrict permissions:
#      sudo chown root:bikroybd /etc/bikroybd/api.env
#      sudo chmod 0640 /etc/bikroybd/api.env
# 3. Generate cryptographic secrets on the VPS before starting the service:
#      openssl rand -hex 64
# ============================================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Public User App Origin & Dedicated Admin Subdomain Origin (HTTPS mandatory)
# User App:   https://recyclrangpur.com (Exclusively for Rangpur City Users)
# Admin App:  https://admin.recyclrangpur.com (Isolated Admin Portal on Separate Domain)
APP_URL=https://recyclrangpur.com
ADMIN_APP_URL=https://admin.recyclrangpur.com
CORS_ORIGIN=https://recyclrangpur.com,https://admin.recyclrangpur.com
TRUSTED_ORIGINS=https://recyclrangpur.com,https://www.recyclrangpur.com,https://admin.recyclrangpur.com
TRUST_PROXY=1

# MySQL 8.0+ Production Connection (Least-Privilege Runtime User: bikroybd_app)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bikroybd_app
DB_PASSWORD=__REPLACE_WITH_VAULT_OR_OPENSSL_GENERATED_DB_PASSWORD__
DB_NAME=bikroybd_db
DB_CONNECTION_LIMIT=30

# JWT & Session Secrets (Must be distinct, >= 64 random hex chars)
JWT_ACCESS_SECRET=__REPLACE_WITH_OPENSSL_RAND_HEX_64_ACCESS_SECRET__
JWT_REFRESH_SECRET=__REPLACE_WITH_OPENSSL_RAND_HEX_64_REFRESH_SECRET__
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Cookie Hardening (HttpOnly + Secure + SameSite=strict)
COOKIE_SECRET=__REPLACE_WITH_OPENSSL_RAND_HEX_64_COOKIE_SECRET__
COOKIE_DOMAIN=.recyclrangpur.com
COOKIE_SAME_SITE=strict
COOKIE_SECURE=true

# Structured JSON Logging
LOG_LEVEL=info
LOG_DIR=/var/log/bikroybd

# Media Object Storage (Cloudinary / S3 Compatible)
CLOUDINARY_CLOUD_NAME=__REPLACE_WITH_CLOUDINARY_CLOUD_NAME__
CLOUDINARY_API_KEY=__REPLACE_WITH_CLOUDINARY_API_KEY__
CLOUDINARY_API_SECRET=__REPLACE_WITH_CLOUDINARY_API_SECRET__
